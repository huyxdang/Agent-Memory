# Copy this file to .env and replace the placeholder with an OpenAI Platform API key.
# Create a key at https://platform.openai.com/api-keys
OPENAI_API_KEY=replace-with-your-openai-api-key

ANSWER_MODEL=gpt-5.6-luna
ANSWER_REASONING_EFFORT=none
EXTRACTION_MODEL=gpt-5.6-luna
EXTRACTION_REASONING_EFFORT=low
EXTRACTION_MAX_TOKENS=128000
JUDGE_MODEL=gpt-5
ANSWER_CONTEXT_WINDOW=1050000
ANSWER_MAX_TOKENS=1024
JUDGE_MAX_TOKENS=4096
TOKENIZER=o200k_base

SPENDING_LIMIT_USD=10
ANSWER_INPUT_USD_PER_MTOK=0.20
ANSWER_CACHED_INPUT_USD_PER_MTOK=0.02
ANSWER_OUTPUT_USD_PER_MTOK=1.20
JUDGE_INPUT_USD_PER_MTOK=1.25
JUDGE_CACHED_INPUT_USD_PER_MTOK=0.125
JUDGE_OUTPUT_USD_PER_MTOK=10.00
